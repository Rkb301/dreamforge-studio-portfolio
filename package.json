{
  "name": "dreamforge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Private offline worldbuilding studio with safe storage and background generation",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/test-browser.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "start": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}
